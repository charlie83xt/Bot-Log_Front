# ---- Bot events (must match FEED_SECRET in the bot's .env) ----
# At least 32 characters. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
FEED_SECRET=""

# ---- Supabase (the same project ES-Collector writes to) ----
# Server-side only. Never put the service key in front-end code.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
# Which symbol's bars to show (as written by ES-Collector's DB_SYMBOL)
FEED_SYMBOL="MES_CONTFUT"
# Minutes before market data and bot events become public
PUBLIC_DELAY_MIN="10"

# ---- Optional: plain-English rephrasing by Gemini (template text is used otherwise) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
NARRATE_WITH_LLM="0"

# ---- Site and donations (defaults live in content/site.json; these override it) ----
# Public address of the page, e.g. https://botlog.example.com (used in X posts, RSS and link previews)
SITE_URL=""
# PayPal.Me handle - any form works: "mandamelos", "paypal.me/mandamelos", "https://www.paypal.me/mandamelos"
SUPPORT_PAYPAL_ME=""
SUPPORT_CURRENCY="GBP"
SUPPORT_BTC=""
SUPPORT_ETH=""
SUPPORT_SOL=""
# Your X account without @ (shows a Follow button)
X_HANDLE=""

# ---- Marketing agent and /admin page ----
# Password for /admin (any user name). At least 24 characters; /admin stays hidden without it.
ADMIN_TOKEN=""
# 1 = write a daily recap, an overnight result and a weekly research fact as drafts
MARKETING_ENABLED="0"
# 1 = post the agent's drafts to X without waiting for your approval (leave 0 until you trust it)
MARKETING_AUTOPOST="0"
# X developer portal -> your app -> Keys and tokens (app permissions must be "Read and write")
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""

# APP_URL is injected by AI Studio / Cloud Run
APP_URL=""
